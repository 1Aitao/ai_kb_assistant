# 复制为 .env 并填入真实值（.env 不提交到 git）

# ===== 必填 =====
DEEPSEEK_API_KEY=your_deepseek_api_key
QWEATHER_KEY=your_qweather_api_key

# ===== 选填（不填使用 config.py 中的默认值）=====
# 大模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.1

# 和风天气
# QWEATHER_BASE_URL=https://devapi.qweather.com
# QWEATHER_GEO_BASE_URL=https://geoapi.qweather.com

# 向量库与嵌入
# CHROMA_DIR=./chroma_db
# CHROMA_COLLECTION=documents
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 分块与检索策略
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# SEARCH_RESULTS=3

# OCR 渲染倍率（默认 1.2；低质量扫描件可调回 2.0 提高识别率）
# OCR_RENDER_SCALE=1.2

# 上传目录
# UPLOAD_DIR=uploads
